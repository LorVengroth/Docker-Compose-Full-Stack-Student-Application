String deployEnv    = 'N/A'
String deployAction = 'N/A'

pipeline {

    agent none

    environment {
        TG_TOKEN   = credentials('TELEGRAM_BOT_TOKEN')
        TG_CHAT_ID = credentials('TELEGRAM_CHAT_ID')
    }

    stages {

        stage('Verify Frontend Environment') {
            agent {
                docker {
                    image 'node:20-alpine'
                    args '-u 0:0'
                }
            }
            steps {
                echo '=== Running Frontend Lint / Test ==='
                dir('student-ui') {
                    sh 'node -v'
                    sh 'npm -v'
                    sh 'npm install'
                }
            }
        }

        stage('Verify Backend Environment') {
            agent {
                docker {
                    image 'maven:3.8.5-openjdk-17'
                }
            }
            steps {
                echo '=== Running Backend Unit Tests ==='
                dir('student-api') {
                    sh 'mvn -version'
                }
            }
        }

        stage('Deployment Approval Gate') {
            agent none
            steps {
                echo '=== Pipeline paused: Waiting for manual approval (Zero Resource Held) ==='
                timeout(time: 15, unit: 'MINUTES') {
                    script {
                        def userInput = input(
                            id: 'DeployGate',
                            message: 'Do you approve the deployment to the target server?',
                            ok: 'Confirm & Execute',
                            parameters: [
                                choice(
                                    name: 'TARGET_ENVIRONMENT',
                                    choices: ['Production', 'Staging'],
                                    description: 'Select the destination environment'
                                ),
                                choice(
                                    name: 'ACTION',
                                    choices: ['Rolling Restart', 'Standard Deploy (Recreate)', 'Tear Down (Stop Only)'],
                                    description: 'Select the deployment action for Docker Compose'
                                )
                            ]
                        )

                        deployEnv    = userInput.TARGET_ENVIRONMENT
                        deployAction = userInput.ACTION
                    }
                }
            }
        }

        stage('Execute Deployment') {
            agent any
            steps {
                echo "=== Executing deployment to: ${deployEnv} ==="

                script {
                    switch (deployAction) {
                        case 'Rolling Restart':
                            echo 'Executing rolling update: rebuilding and updating services in-place...'
                            sh 'docker compose up -d --build'
                            break

                        case 'Standard Deploy (Recreate)':
                            echo 'Executing full recreate: stopping all containers before recreation...'
                            sh 'docker compose down'
                            sh 'docker compose up -d --build'
                            break

                        case 'Tear Down (Stop Only)':
                            echo 'Tearing down all containers and networks...'
                            sh 'docker compose down'
                            break

                        default:
                            error("Unknown deployment action: ${deployAction}")
                            break
                    }
                }
            }
        }

        stage('Health Check') {
            agent any
            steps {
                echo '=== Verifying service health after deployment ==='
                sleep time: 5, unit: 'SECONDS'
                sh 'docker compose ps'
            }
        }
    }

    post {
        always {
            
            node('built-in') {
                script {
                    // Assign emoji and text based on current pipeline status
                    def statusEmoji = (currentBuild.currentResult == 'SUCCESS') ? '✅' : '❌'
                    def statusText  = currentBuild.currentResult ?: 'UNKNOWN'

                    def message = """
                    ${statusEmoji} <b>CI/CD Pipeline Alert</b>
                    
                    <b>Project:</b> ${env.JOB_NAME}
                    <b>Build Number:</b> #${env.BUILD_NUMBER}
                    <b>Status:</b> ${statusText}
                    <b>Environment:</b> ${deployEnv}
                    <b>Action:</b> ${deployAction}
                    <b>Console Log:</b> <a href="${env.BUILD_URL}console">View Jenkins Console</a>
                    """

                    sh """
                        curl -s -X POST "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
                            -d "chat_id=${TG_CHAT_ID}" \
                            -d "parse_mode=HTML" \
                            --data-urlencode "text=${message}"
                    """
                }
            }
        }

        success {
            echo "Pipeline completed and deployed to ${deployEnv} successfully!"
        }
        aborted {
            echo 'Pipeline was aborted by the user or timed out.'
        }
        failure {
            echo 'Pipeline execution encountered a failure!'
        }
    }
}
