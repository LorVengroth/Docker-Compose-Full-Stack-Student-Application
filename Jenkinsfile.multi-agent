String deployEnv    = 'N/A'
String deployAction = 'N/A'

pipeline {

    agent none

    environment {
        CLEAN_VOLUMES = 'false'
        
        TG_TOKEN   = credentials('TELEGRAM_BOT_TOKEN')
        TG_CHAT_ID = credentials('TELEGRAM_CHAT_ID')
    }

    stages {

        stage('Continuous Integration (Test & Verify)') {
            parallel {

                stage('Test & Verify Frontend') {
                    agent {
                        docker {
                            image 'node:20-alpine'
                            // Mount host cache for npm packages and run as root to avoid permission issues
                            args '-u 0:0 -v /tmp/jenkins-cache/npm:/root/.npm'
                        }
                    }
                    steps {
                        echo '=== Running Frontend Lint / Test ==='
                        dir('student-ui') {
                            sh 'node -v'
                            sh 'npm -v'
                            // Use npm ci for clean, reproducible builds from package-lock.json
                            sh 'npm ci --prefer-offline'
                            // Run linting if defined in package.json
                            sh 'npm run lint --if-present'
                            // CI=true prevents test runners (e.g., Jest) from hanging in watch mode
                            sh 'CI=true npm test -- --passWithNoTests'
                            // Validate production build bundle
                            sh 'npm run build --if-present'
                        }
                    }
                }

                stage('Test & Verify Backend') {
                    agent {
                        docker {
                            image 'maven:3.8.5-openjdk-17'
                            // Mount host cache for .m2 dependencies so they persist across runs
                            args '-v /tmp/jenkins-cache/m2:/root/.m2'
                        }
                    }
                    steps {
                        echo '=== Running Backend Unit Tests ==='
                        dir('student-api') {
                            sh 'mvn -version'
                            // Clean old classes and run tests in non-interactive batch mode
                            sh 'mvn clean test -B'
                        }
                    }
                    post {
                        always {
                            // Collect test reports and display test trends in Jenkins UI
                            junit testResults: 'student-api/target/surefire-reports/*.xml', allowEmptyResults: true
                        }
                    }
                }

            }
        }

        stage('Deployment Approval Gate') {
            agent none
            steps {
                echo '=== Pipeline paused: Waiting for manual approval (Zero Resource Held) ==='
                timeout(time: 15, unit: 'MINUTES') {
                    script {
                        def userInput = input(
                            id: 'DeployGate',
                            message: 'Do you approve the deployment to the target server?',
                            ok: 'Confirm & Execute',
                            parameters: [
                                choice(
                                    name: 'TARGET_ENVIRONMENT',
                                    choices: ['Production', 'Staging'],
                                    description: 'Select the destination environment'
                                ),
                                choice(
                                    name: 'ACTION',
                                    choices: ['Standard Deploy (Recreate)', 'Rolling Restart', 'Tear Down (Stop Only)'],
                                    description: 'Select the deployment action for Docker Compose'
                                ),
                                booleanParam(
                                    name: 'REMOVE_OLD_VOLUMES',
                                    defaultValue: false,
                                    description: 'Check to wipe database volumes (docker compose down -v)'
                                )
                            ]
                        )

                        deployEnv         = userInput.TARGET_ENVIRONMENT
                        deployAction      = userInput.ACTION
                        env.CLEAN_VOLUMES = userInput.REMOVE_OLD_VOLUMES.toString()
                    }
                }
            }
        }

        stage('Execute Deployment') {
            agent any
            steps {
                echo "=== Executing deployment to: ${deployEnv} ==="

                script {
                    if (deployAction == 'Tear Down (Stop Only)') {
                        sh 'docker compose down'
                    } else {
                        // Check boolean condition correctly
                        if (env.CLEAN_VOLUMES.toBoolean()) {
                            sh 'docker compose down -v'
                        } else {
                            sh 'docker compose down'
                        }
                        // Build Docker image and run containers in background
                        sh 'docker compose up -d --build'
                    }
                }
            }
        }

        stage('Health Check') {
            agent any
            steps {
                echo '=== Verifying service health after deployment ==='
                sleep time: 5, unit: 'SECONDS'
                sh 'docker compose ps'
            }
        }
    }

    post {
        always {
            // Allocate a lightweight agent on the host to execute the curl command
            node('built-in') {
                script {
                    // Assign emoji and text based on current pipeline status
                    def statusEmoji = (currentBuild.currentResult == 'SUCCESS') ? '✅' : '❌'
                    def statusText  = currentBuild.currentResult ?: 'UNKNOWN'

                    def message = """
                    ${statusEmoji} <b>CI/CD Pipeline Alert</b>
                    
                    <b>Project:</b> ${env.JOB_NAME}
                    <b>Build Number:</b> #${env.BUILD_NUMBER}
                    <b>Status:</b> ${statusText}
                    <b>Environment:</b> ${deployEnv}
                    <b>Action:</b> ${deployAction}
                    <b>Console Log:</b> <a href="${env.BUILD_URL}console">View Jenkins Console</a>
                    """

                    sh """
                        curl -s -X POST "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
                            -d "chat_id=${TG_CHAT_ID}" \
                            -d "parse_mode=HTML" \
                            --data-urlencode "text=${message}"
                    """
                }
            }
        }

        success {
            echo "Pipeline completed and deployed to ${deployEnv} successfully!"
        }
        aborted {
            echo 'Pipeline was aborted by the user or timed out.'
        }
        failure {
            echo 'Pipeline execution encountered a failure!'
        }
    }
}
